    "source": "#include \"MappedSceneConfiguration.hpp\"\n#include <algorithm>\n#include <chrono>\n#include <cmath>\n#include <iomanip>\n#include <iostream>\n#include <unordered_set>\n#include <vector>\nint main(int argc,char** argv) {\n    if(argc!=4)return 64;\n    const auto cfg=YAML::LoadFile(argv[1]);std::unordered_set<std::string> profiles;\n    for(const auto& p:cfg[\"agents\"][\"road_user_taxonomy\"])profiles.insert(p[\"type\"].as<std::string>());\n    ump::MappedScene scene(readMappedSceneConfiguration(cfg[\"mapped_scene\"],cfg[\"simulation\"][\"width\"].as<double>(),cfg[\"simulation\"][\"height\"].as<double>(),profiles));\n    const auto horizon=std::stoll(argv[2]);const double budget=std::stod(argv[3]);\n    const auto begin=std::chrono::steady_clock::now();double lastReport=0;std::vector<double> steps;\n    ump::AggregationTime reached=0;bool timedOut=false;\n    const auto elapsed=[&](){return std::chrono::duration<double>(std::chrono::steady_clock::now()-begin).count();};\n    const auto report=[&](const char* kind){\n        const auto d=scene.motionDiagnostics();auto f=scene.frameAt(reached);std::size_t stopped=0,north=0,neck=0,south=0;\n        for(const auto& t:f){if(std::hypot(t.velocity.x,t.velocity.y)<1e-7)++stopped;\n            if(t.position.x>=60&&t.position.x<=73){if(t.position.y<35)++north;else if(t.position.y<=45)++neck;else ++south;}}\n        std::cout<<std::setprecision(12)<<\"{\\\"kind\\\":\\\"\"<<kind<<\"\\\",\\\"sim_ms\\\":\"<<reached<<\",\\\"wall_s\\\":\"<<elapsed()\n            <<\",\\\"starts\\\":\"<<d.realizedStarts<<\",\\\"ends\\\":\"<<d.realizedEnds<<\",\\\"active\\\":\"<<d.activeTracks<<\",\\\"pending\\\":\"<<d.pendingTracks\n            <<\",\\\"stalled\\\":\"<<d.activeStalledTracks<<\",\\\"stopped_now\\\":\"<<stopped<<\",\\\"max_stop_ms\\\":\"<<d.maxConsecutiveStopMs\n            <<\",\\\"overlaps\\\":\"<<d.overlapViolations<<\",\\\"replans\\\":\"<<d.navigationReplans<<\",\\\"replan_failures\\\":\"<<d.navigationReplanFailures\n            <<\",\\\"max_search_nodes\\\":\"<<d.navigationMaxSearchNodes<<\",\\\"candidate_checks\\\":\"<<d.navigationCandidateChecks\n            <<\",\\\"north_approach_active\\\":\"<<north<<\",\\\"neck_box_active\\\":\"<<neck<<\",\\\"south_approach_active\\\":\"<<south<<\"}\"<<std::endl;\n    };\n    report(\"initial\");\n    for(ump::AggregationTime at=scene.configuration().motionStepMs;at<=horizon;at+=scene.configuration().motionStepMs){\n        const auto start=std::chrono::steady_clock::now();scene.advanceTo(at);reached=at;\n        steps.push_back(std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count());\n        const double wall=elapsed();if(at%10000==0||wall-lastReport>=15){report(\"progress\");lastReport=elapsed();}\n        if(elapsed()>=budget){timedOut=true;break;}\n    }\n    report(timedOut?\"wall_budget\":\"horizon\");\n    std::sort(steps.begin(),steps.end());double sum=0;std::size_t above=0;for(double v:steps){sum+=v;if(v>50)++above;}\n    const auto quantile=[&](double p){return steps[std::min(steps.size()-1,static_cast<std::size_t>(std::ceil(p*steps.size())-1))];};\n    std::cout<<\"{\\\"kind\\\":\\\"step_summary\\\",\\\"steps\\\":\"<<steps.size()<<\",\\\"mean_ms\\\":\"<<sum/steps.size()<<\",\\\"p50_ms\\\":\"<<quantile(.5)\n        <<\",\\\"p95_ms\\\":\"<<quantile(.95)<<\",\\\"p99_ms\\\":\"<<quantile(.99)<<\",\\\"max_ms\\\":\"<<steps.back()<<\",\\\"above_50ms\\\":\"<<above<<\"}\"<<std::endl;\n    return timedOut?2:0;\n}\n"
